// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 💡 注意：在 Prisma 7+ 中，url 和 directUrl 不再写在这里
  // 它们由项目根目录下的 prisma.config.ts 来管理
}

// 👤 用户模型
model User {
  id          String        @id @default(cuid())
  name        String?       
  email       String?       @unique 
  password    String?       
  createdAt   DateTime      @default(now()) 
  
  tarotDraws  TarotRecord[] 
}

// 🎴 抽牌记录模型
model TarotRecord {
  id          String   @id @default(cuid())
  userId      String   
  question    String?  
  cardName    String   
  isReversed  Boolean  @default(false) 
  reading     String   
  drawnAt     DateTime @default(now()) 

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}